{
  "name": "n8n-nodes-raynet",
  "version": "1.0.7",
  "description": "n8n custom node for Raynet CRM v2",
  "keywords": [
    "n8n-community-node-package",
    "raynet",
    "crm"
  ],
  "author": {
    "name": "Marek Maňásek",
    "email": "manasek@raynet.cz"
  },
  "license": "MIT",
  "homepage": "https://github.com/raynetcrm/n8n-nodes-raynet-crm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raynetcrm/n8n-nodes-raynet-crm.git"
  },
  "bugs": {
    "email": "manasek@raynet.cz"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "format": "oxfmt nodes/ credentials/",
    "format:check": "oxfmt --check nodes/ credentials/",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/RaynetApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Raynet/Raynet.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.23.1",
    "@types/node": "25.5.0",
    "eslint": "10.1.0",
    "eslint-plugin-n8n-nodes-base": "1.16.6",
    "oxfmt": "0.42.0",
    "typescript": "6.0.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

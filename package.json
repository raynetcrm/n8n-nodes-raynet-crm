{
  "name": "n8n-nodes-raynet",
  "version": "1.0.0",
  "description": "n8n custom node for Raynet CRM v2",
  "keywords": [
    "n8n-community-node-package",
    "raynet",
    "crm"
  ],
  "license": "MIT",
  "homepage": "https://n8n.io",
  "author": {},
  "repository": {},
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/RaynetApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Raynet/Raynet.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.23.1",
    "@types/node": "25.5.0",
    "eslint": "10.1.0",
    "eslint-plugin-n8n-nodes-base": "1.16.6",
    "prettier": "3.8.1",
    "typescript": "6.0.2"
  },
  "dependencies": {
    "n8n-workflow": "2.13.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
